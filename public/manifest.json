{
  "manifest_version": 3,
  "name": "{APP_NAME}",
  "description": "{APP_DESCRIPTION}",
  "version": "3.0.0",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "{APP_DESCRIPTION}"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": "{APP_ID}19-in.png",
    "default_title": "{APP_NAME}"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "{APP_ID}128.png",
    "48": "{APP_ID}48.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": ["{webUrl}"]
  }
}
