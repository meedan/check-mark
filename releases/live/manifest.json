{
  "manifest_version": 3,
  "name": "Check",
  "description": "Verify breaking news online",
  "version": "4.0.0",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Verify breaking news online"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": "check19-in.png",
    "default_title": "Check"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "check128.png",
    "48": "check48.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "matches": ["https://checkmedia.org/"]
  }
}
